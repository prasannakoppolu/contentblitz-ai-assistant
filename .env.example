# Copy to .env and fill in what you have. Every key is optional:
# missing providers are skipped and the app falls back down the chain to offline mock providers.

APP_ENV=development            # development | production | test
CONTENTBLITZ_MOCK=0            # 1 = force offline demo mode (no API calls, no cost)
LOG_LEVEL=INFO
# CONTENTBLITZ_OUTPUT_DIR=outputs
CONTENTBLITZ_MEMORY=memory     # memory (lost on restart) | sqlite (kept across restarts)
# CONTENTBLITZ_MEMORY_PATH=contentblitz_memory.sqlite

# --- Accounts and sign-in (email + 6-digit one-time code) ---
ADMIN_EMAILS=                  # comma-separated; these accounts get the /admin dashboard
# CONTENTBLITZ_AUTH_DB=data/contentblitz_auth.sqlite   # accounts, sessions, conversation lists, admin settings
CONTENTBLITZ_AUTH_DEV_CODES=0  # 1 = show the code on screen when SMTP isn't set (local development only)
CONTENTBLITZ_COOKIE_SECURE=0   # 1 when served over HTTPS
# Email delivery for codes. Leave SMTP_HOST empty to print codes in the server log instead.
SMTP_HOST=                     # e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org
SMTP_PORT=587                  # 465 = implicit TLS, otherwise STARTTLS
SMTP_USER=                     # Gmail: your address + an app password; SendGrid: "apikey"
SMTP_PASSWORD=
SMTP_FROM=                     # e.g. "ContentBlitz <no-reply@yourdomain.com>"
SMTP_STARTTLS=1

# --- LLMs via LangChain chat models (fallback order: OpenAI -> Anthropic -> Gemini -> mock) ---
OPENAI_API_KEY=                # GPT-4o / GPT-4o-mini, also used for DALL-E 3 / DALL-E 2
ANTHROPIC_API_KEY=             # Claude Sonnet / Haiku
GOOGLE_API_KEY=                # Gemini 2.0 Flash (generous free tier)

# --- Research (fallback order: SERP API -> Perplexity -> Tavily -> mock) ---
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# --- Images (fallback order: DALL-E 3 -> DALL-E 2 -> Stability -> local placeholder) ---
STABILITY_API_KEY=

# --- Observability (optional): LangSmith traces every agent subgraph, chain and model call ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contentblitz
